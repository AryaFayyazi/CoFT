__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Raw third-party data that we cannot redistribute (see scripts/fetch_data.py)
data/raw/
!data/raw/.gitkeep

# Derived caches (regenerated on demand)
results/cache/
.cache/
logs/
*.log
wandb/

# Machine-local environment
.env.local

# Experiment outputs are not shipped: the paper carries the numbers, this
# repository carries the implementation that produces them.  `make all`
# regenerates everything under results/ locally.
results/*
!results/.gitkeep
